<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/reze_surface"
    android:paddingTop="6.0dip"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="6.0dip"
        android:paddingBottom="6.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16.0dip"
        android:paddingEnd="6.0dip"
        android:paddingVertical="6.0dip">
        <TextView
            android:textSize="14.0sp"
            android:textColor="@color/reze_on_surface"
            android:ellipsize="end"
            android:id="@id/log_title"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1.0"
            android:fontFamily="monospace" />
        <ImageButton
            android:id="@id/log_stop"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="10.0dip"
            android:layout_width="42.0dip"
            android:layout_height="42.0dip"
            android:src="@drawable/ic_stop_24"
            android:scaleType="fitCenter"
            android:tint="@color/reze_crimson"
            android:contentDescription="Stop" />
        <ImageButton
            android:id="@id/log_close"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="10.0dip"
            android:layout_width="42.0dip"
            android:layout_height="42.0dip"
            android:src="@drawable/ic_close_24"
            android:scaleType="fitCenter"
            android:tint="@color/reze_on_surface_muted"
            android:contentDescription="@string/nav_close" />
    </LinearLayout>
    <View
        android:background="@color/reze_outline"
        android:layout_width="fill_parent"
        android:layout_height="1.0dip" />
    <ScrollView
        android:id="@id/log_scroll"
        android:scrollbars="none"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0">
        <TextView
            android:textSize="12.5sp"
            android:textColor="@color/reze_on_surface_muted"
            android:id="@id/log_text"
            android:padding="14.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:fontFamily="monospace" />
    </ScrollView>
</LinearLayout>