<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/reze_bg"
    android:fitsSystemWindows="true"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@id/toolbar"
        android:background="@color/reze_bg"
        android:layout_width="fill_parent"
        android:layout_height="?actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:title="Offline models"
        app:titleTextColor="@color/reze_on_surface" />
    <ScrollView
        android:scrollbars="none"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:orientation="vertical"
            android:padding="16.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="13.0sp"
                android:textColor="@color/reze_on_surface_muted"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="Run a model entirely on this device, with no internet. Downloads come straight from Hugging Face. Bigger models are smarter but need more RAM and storage." />
            <TextView
                android:textSize="12.0sp"
                android:textColor="@color/reze_on_surface_muted"
                android:id="@id/ram_note"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.0dip" />
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/model_list"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.0dip" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>