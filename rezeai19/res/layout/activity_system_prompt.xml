<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/reze_bg"
    android:fitsSystemWindows="true"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@id/toolbar"
        android:background="@color/reze_bg"
        android:layout_width="fill_parent"
        android:layout_height="?actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:title="System prompt"
        app:titleTextColor="@color/reze_on_surface" />
    <TextView
        android:textSize="14.0sp"
        android:textColor="@color/reze_on_surface_muted"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20.0dip"
        android:layout_marginTop="4.0dip"
        android:layout_marginRight="20.0dip"
        android:text="The instructions RezeAI follows in every chat. Edit it to change how the assistant behaves. Each chat's own workspace note is added automatically."
        android:layout_marginHorizontal="20.0dip" />
    <EditText
        android:textSize="14.0sp"
        android:typeface="monospace"
        android:textColor="@color/reze_on_surface"
        android:textColorHint="@color/reze_on_surface_muted"
        android:gravity="top"
        android:id="@id/system_prompt_input"
        android:background="@drawable/bg_input"
        android:padding="16.0dip"
        android:scrollbars="vertical"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_margin="16.0dip"
        android:hint="System prompt"
        android:layout_weight="1.0"
        android:inputType="textMultiLine|textNoSuggestions"
        android:overScrollMode="always" />
    <LinearLayout
        android:orientation="horizontal"
        android:paddingLeft="16.0dip"
        android:paddingRight="16.0dip"
        android:paddingBottom="16.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16.0dip">
        <com.google.android.material.button.MaterialButton
            android:textColor="@color/reze_on_surface"
            android:id="@id/reset_prompt_button"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="Reset to default"
            android:layout_weight="1.0"
            android:layout_marginEnd="10.0dip"
            app:strokeColor="@color/reze_outline"
            style="@style/Widget.Material3.Button.OutlinedButton" />
        <com.google.android.material.button.MaterialButton
            android:id="@id/save_prompt_button"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="Save"
            android:layout_weight="1.0"
            app:backgroundTint="@color/reze_crimson" />
    </LinearLayout>
</LinearLayout>