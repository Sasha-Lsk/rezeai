<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/reze_bg"
    android:paddingTop="18.0dip"
    android:paddingBottom="14.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textSize="20.0sp"
        android:textStyle="bold"
        android:textColor="@color/reze_on_surface"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="22.0dip"
        android:layout_marginRight="22.0dip"
        android:text="Add to a chat"
        android:fontFamily="@font/space_grotesk"
        android:layout_marginHorizontal="22.0dip" />
    <TextView
        android:textSize="14.0sp"
        android:textColor="@color/reze_on_surface_muted"
        android:id="@id/share_subtitle"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="22.0dip"
        android:layout_marginTop="4.0dip"
        android:layout_marginRight="22.0dip"
        android:text="Pick a chat or start a new one."
        android:layout_marginHorizontal="22.0dip" />
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/share_new_chat_row"
        android:background="?selectableItemBackground"
        android:paddingLeft="22.0dip"
        android:paddingTop="14.0dip"
        android:paddingRight="22.0dip"
        android:paddingBottom="14.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14.0dip"
        android:paddingHorizontal="22.0dip"
        android:paddingVertical="14.0dip">
        <ImageView
            android:layout_width="24.0dip"
            android:layout_height="24.0dip"
            android:src="@drawable/ic_add_24"
            android:layout_marginEnd="16.0dip"
            app:tint="@color/reze_crimson"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
        <TextView
            android:textSize="16.0sp"
            android:textStyle="bold"
            android:textColor="@color/reze_crimson"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New chat" />
    </LinearLayout>
    <View
        android:background="@color/reze_outline"
        android:layout_width="fill_parent"
        android:layout_height="1.0dip"
        android:layout_marginLeft="22.0dip"
        android:layout_marginRight="22.0dip"
        android:layout_marginHorizontal="22.0dip" />
    <TextView
        android:textSize="13.0sp"
        android:textStyle="bold"
        android:textColor="@color/reze_on_surface_muted"
        android:id="@id/share_recent_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14.0dip"
        android:layout_marginBottom="2.0dip"
        android:text="Recent chats"
        android:layout_marginStart="22.0dip" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@id/share_chat_list"
        android:paddingLeft="10.0dip"
        android:paddingRight="10.0dip"
        android:scrollbars="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10.0dip" />
</LinearLayout>