<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="?selectableItemBackground"
    android:paddingLeft="16.0dip"
    android:paddingTop="12.0dip"
    android:paddingRight="16.0dip"
    android:paddingBottom="12.0dip"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16.0dip"
    android:paddingVertical="12.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout
        android:layout_width="42.0dip"
        android:layout_height="42.0dip">
        <ImageView
            android:layout_gravity="center"
            android:id="@id/icon"
            android:layout_width="28.0dip"
            android:layout_height="28.0dip" />
        <ImageView
            android:id="@id/thumb"
            android:background="@drawable/bg_thumb"
            android:visibility="gone"
            android:layout_width="42.0dip"
            android:layout_height="42.0dip"
            android:scaleType="centerCrop"
            android:clipToOutline="true" />
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_weight="1.0"
        android:layout_marginStart="14.0dip">
        <TextView
            android:textSize="15.0sp"
            android:textColor="@color/reze_on_surface"
            android:ellipsize="middle"
            android:id="@id/name"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:maxLines="1" />
        <TextView
            android:textSize="12.0sp"
            android:textColor="@color/reze_on_surface_muted"
            android:id="@id/info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1.0dip" />
    </LinearLayout>
    <ImageView
        android:id="@id/chevron"
        android:visibility="gone"
        android:layout_width="18.0dip"
        android:layout_height="18.0dip"
        android:src="@drawable/ic_chevron_right_24"
        android:tint="@color/reze_on_surface_muted" />
</LinearLayout>