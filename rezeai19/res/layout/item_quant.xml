<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:paddingTop="8.0dip"
    android:paddingBottom="8.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="8.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0">
            <TextView
                android:textSize="15.0sp"
                android:textColor="@color/reze_on_surface"
                android:id="@id/quant_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <TextView
                android:textSize="12.0sp"
                android:textColor="@color/reze_on_surface_muted"
                android:id="@id/quant_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:textColor="@color/reze_on_surface"
            android:id="@id/quant_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="96.0dip"
            android:text="Download"
            app:strokeColor="@color/reze_outline"
            style="@style/Widget.Material3.Button.OutlinedButton" />
        <com.google.android.material.button.MaterialButton
            android:textColor="@color/reze_crimson"
            android:id="@id/quant_delete"
            android:paddingLeft="10.0dip"
            android:paddingRight="10.0dip"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0.0dip"
            android:text="Delete"
            android:layout_marginStart="2.0dip"
            android:paddingHorizontal="10.0dip"
            style="@style/Widget.Material3.Button.TextButton" />
    </LinearLayout>
    <ProgressBar
        android:id="@id/quant_progress"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6.0dip"
        android:max="100"
        android:indeterminate="false"
        android:progressTint="@color/reze_crimson"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal" />
    <TextView
        android:textSize="11.0sp"
        android:textColor="@color/reze_on_surface_muted"
        android:id="@id/quant_progress_text"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2.0dip" />
</LinearLayout>