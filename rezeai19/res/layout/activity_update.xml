<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center"
    android:orientation="vertical"
    android:background="@color/reze_bg"
    android:padding="32.0dip"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:layout_width="88.0dip"
        android:layout_height="88.0dip"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="@string/app_name" />
    <TextView
        android:textSize="22.0sp"
        android:textStyle="bold"
        android:textColor="@color/reze_on_surface"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24.0dip"
        android:text="Update required" />
    <TextView
        android:textSize="15.0sp"
        android:textColor="@color/reze_on_surface_muted"
        android:gravity="center"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10.0dip"
        android:text="A newer version of RezeAI is available. Please update to keep using the app." />
    <com.google.android.material.button.MaterialButton
        android:id="@id/update_button"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28.0dip"
        android:text="Update now"
        app:backgroundTint="@color/reze_crimson" />
</LinearLayout>